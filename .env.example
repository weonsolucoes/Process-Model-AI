# Database (SQLite file for MVP simplicity; swap DATABASE_URL to a Postgres
# connection string later without touching application code — Prisma abstracts it).
DATABASE_URL="file:./dev.db"

# JWT signing secret for session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"

# AI provider. When ANTHROPIC_API_KEY is unset, the app falls back to the
# deterministic MockAIProvider (useful for local dev/tests without spending
# real API credits). Set AI_PROVIDER=anthropic explicitly to force real calls.
AI_PROVIDER="mock"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"
