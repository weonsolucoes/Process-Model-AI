{
  "name": "weon-ai-process",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "DATABASE_URL=file:./e2e-test.db npx prisma db push --skip-generate --accept-data-loss",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.124.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "jose": "6.2.12",
    "mermaid": "11.17.2",
    "next": "16.3.4",
    "playwright-core": "1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.15.29",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.7",
    "prisma": "6.19.3",
    "tsx": "4.23.13",
    "typescript": "5.6.3",
    "vitest": "5.0.0"
  }
}
